---
import type { PageContent } from '../data/content';
import { shared } from '../data/content';

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const languageOptions = [
  { code: 'es', label: 'Español' },
  { code: 'en', label: 'English' },
  { code: 'gl', label: 'Galego' },
] as const;
---

<a class="skip-link" href="#content">{content.skipContent}</a>
<div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
<header class="site-header" data-site-header>
  <a class="monogram" href={withBase(`${content.lang}/`)} aria-label={content.name}>RE<span>.</span></a>
  <nav aria-label={content.navigationLabel}>
    <a href="#profile" data-nav-link>{content.nav.profile}</a>
    <a href="#path" data-nav-link>{content.nav.path}</a>
    <a href="#work" data-nav-link>{content.nav.work}</a>
    <a href="#skills" data-nav-link>{content.nav.skills}</a>
    <a href="#contact" data-nav-link>{content.nav.contact}</a>
  </nav>
  <label class="language-picker">
    <span class="visually-hidden">{content.languageSelectorLabel}</span>
    <select aria-label={content.languageSelectorLabel} data-language-picker>
      {languageOptions.map(({ code, label }) => <option value={withBase(`${code}/`)} selected={content.lang === code}>{label}</option>)}
    </select>
  </label>
</header>

<main id="content">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-image" aria-hidden="true">
      <img src={withBase('/images/raquel-escudero.jpeg')} alt="" width="1300" height="1733" />
    </div>
    <div class="hero-shade"></div>
    <div class="hero-copy">
      <p class="eyebrow reveal reveal-delay-1">{content.eyebrow}</p>
      <h1 id="hero-title" class="reveal reveal-delay-2">{content.name}</h1>
      <p class="role reveal reveal-delay-3">{content.role}</p>
      <p class="hero-intro reveal reveal-delay-4">{content.intro}</p>
      <div class="hero-actions reveal reveal-delay-5">
        <a class="text-action" href="#profile">{content.heroCta} <span aria-hidden="true">↓</span></a>
        {content.cvHref && <a class="outline-action" href={withBase(content.cvHref)} download>{content.cvLabel} <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
    <p class="hero-edition" aria-hidden="true">{content.heroDetail}</p>
    <p class="hero-index" aria-hidden="true">01 / 04</p>
  </section>

  <section id="profile" class="statement section-shell editorial-statement" aria-labelledby="profile-heading" data-reveal>
    <div class="section-heading">
      <p class="section-label">{content.profile.label}</p>
      <h2 id="profile-heading">{content.profile.heading}</h2>
    </div>
    <div class="statement-copy">
      <p>{content.profile.body}</p>
    </div>
  </section>

  <section id="path" class="timeline-section section-shell editorial-timeline" aria-labelledby="path-heading" data-reveal>
    <div class="section-heading">
      <p class="section-label">{content.path.label}</p>
      <h2 id="path-heading">{content.path.heading}</h2>
    </div>
    <ol class="timeline">
      {content.path.items.map((item) => (
        <li class="timeline-item">
          <p class="timeline-year">{item.year}</p>
          <div>
            <h3>{item.title}</h3>
            {item.institution && <p class="institution">{item.institution}</p>}
            <p>{item.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="work" class="work-section" aria-labelledby="work-heading" data-reveal>
    <div class="section-shell work-grid">
      <div class="section-heading">
        <p class="section-label">{content.work.label}</p>
        <h2 id="work-heading">{content.work.heading}</h2>
      </div>
      <div class="work-intro">
        <p>{content.work.intro}</p>
      </div>
      <div class="work-list">
        {content.work.items.map((item) => (
          <article class="work-item">
            <p class="work-kind">{item.kind}</p>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
            {item.href && <a class="publication-link" href={item.href} target="_blank" rel="noreferrer">{item.linkLabel} <span aria-hidden="true">↗</span></a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="skills" class="skills-section section-shell" aria-labelledby="skills-heading" data-reveal>
    <div class="section-heading">
      <p class="section-label">{content.skills.label}</p>
      <h2 id="skills-heading">{content.skills.heading}</h2>
    </div>
    <div class="skills-lists">
      <div>
        <h3>{content.skills.languages}</h3>
        <ul>
          {content.skills.languageItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h3>{content.skills.capabilities}</h3>
        <ul>
          {content.skills.capabilityItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="complete-cv" class="complete-cv-section section-shell" aria-labelledby="complete-cv-heading" data-reveal>
    <div class="section-heading complete-cv-intro">
      <p class="section-label">{content.completeCv.label}</p>
      <h2 id="complete-cv-heading">{content.completeCv.heading}</h2>
    </div>
    <p class="complete-cv-note">{content.completeCv.note}</p>
    <div class="cv-groups">
      {content.completeCv.groups.map((group) => (
        <details class="cv-group">
          <summary>
            <span>{group.title}</span>
          </summary>
          <div class="cv-items">
            {group.items.map((item) => (
              <article class="cv-item">
                <div>
                  <h4>{item.title}</h4>
                  <p>{item.detail}</p>
                </div>
                {item.status && <span class:list={['status', item.status === 'Acreditado' && 'status-verified', item.status === 'Declarado' && 'status-declared', item.status === 'Parcialmente acreditado' && 'status-partial']}>{item.status}</span>}
              </article>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section id="contact" class="contact-section" aria-labelledby="contact-heading" data-reveal>
    <div class="section-shell contact-grid">
      <div class="section-heading">
        <p class="section-label">{content.contact.label}</p>
        <h2 id="contact-heading">{content.contact.heading}</h2>
      </div>
      <div class="contact-content">
        <p>{content.contact.body}</p>
        <div class="contact-actions">
          {content.linkedinUrl && <a class="contact-linkedin" href={content.linkedinUrl} target="_blank" rel="noreferrer">{content.contact.linkedinLabel} <span aria-hidden="true">↗</span></a>}
        </div>
        <p class="contact-location">{shared.location}</p>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div>
    <p>{content.name}</p>
    <p class="footer-detail">{content.footer} · 2026</p>
  </div>
  <div class="footer-links">
    {content.linkedinUrl && <a href={content.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>}
    <a href="#content">{content.backToTop} ↑</a>
  </div>
  <p class="publication-note">{content.publicationNote}</p>
</footer>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const setHeaderState = () => header?.classList.toggle('is-scrolled', window.scrollY > 36);
  const setPageState = () => {
    setHeaderState();
    if (progress) {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = `scaleX(${scrollable > 0 ? window.scrollY / scrollable : 0})`;
    }
  };
  setPageState();
  window.addEventListener('scroll', setPageState, { passive: true });

  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  window.addEventListener('pageshow', () => {
    if (!window.location.hash) window.requestAnimationFrame(() => window.scrollTo(0, 0));
  });

  document.querySelectorAll<HTMLSelectElement>('[data-language-picker]').forEach((picker) => {
    picker.addEventListener('change', () => {
      window.location.assign(`${picker.value}${window.location.hash}`);
    });
  });

  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('has-scroll-reveals');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    revealItems.forEach((item) => observer.observe(item));
  }

  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  if ('IntersectionObserver' in window) {
    const navObserver = new IntersectionObserver((entries) => {
      const active = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!active) return;
      navLinks.forEach((link) => link.classList.toggle('is-active', link.getAttribute('href') === `#${active.target.id}`));
    }, { rootMargin: '-32% 0px -58% 0px', threshold: [0.01, 0.25, 0.5] });
    navLinks.forEach((link) => {
      const section = document.querySelector(link.getAttribute('href') ?? '');
      if (section) navObserver.observe(section);
    });
  }
</script>
