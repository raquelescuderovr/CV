---
import BaseLayout from '../layouts/BaseLayout.astro';
import { content } from '../data/content';
---

<BaseLayout content={content.es}>
  <main class="not-found">
    <p class="section-label">404</p>
    <h1>Esta página no existe.</h1>
    <a class="text-action" href={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`}es/`}>Volver al portfolio <span aria-hidden="true">→</span></a>
  </main>
</BaseLayout>
