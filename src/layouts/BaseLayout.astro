---
import '../styles/global.css';
import type { PageContent } from '../data/content';

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const siteBase = new URL(base, Astro.site);
const languages = ['es', 'en', 'gl'] as const;
---

<!doctype html>
<html lang={content.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#352D3C" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {languages.map((language) => <link rel="alternate" hreflang={language} href={new URL(`${language}/`, siteBase)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('es/', siteBase)} />
    <title>{content.title}</title>
    <meta name="description" content={content.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={content.locale.replace('-', '_')} />
    <meta property="og:title" content={content.title} />
    <meta property="og:description" content={content.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('images/raquel-escudero.jpeg', siteBase)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
